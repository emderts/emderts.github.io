 "talents": [
  {
   "id": "ape-knight",
   "name": "Ape Knight",
   "tier": "starting",
   "abilities": [
    {
     "name": "Shifter's Grace",
     "text": "When you are about to perform Heat Refresh, roll a [d10] and add +1 to the result for every Bane [Bane] token you have. If the result is equal to or lower than your current [Heat], Shapeshift. When you Shapeshift, you may move 1 space.",
     "ops": [
      {
       "op": "shiftersGrace"
      },
      {
       "op": "shiftMove",
       "n": 1
      }
     ]
    },
    {
     "name": "Troop Tactics",
     "text": "When you are about to attack, if the last Knight who dealt a Wound (other than you) is not on the same side of the Monster as you, gain Auto-break 1.",
     "ops": [
      {
       "op": "troopTactics"
      }
     ],
     "note": "'Same side of the Monster' = the same quadrant (front/back/left/right by the larger axis) around the Monster."
    }
   ]
  },
  {
   "id": "primal-warrior",
   "name": "Primal Warrior",
   "tier": "vassal",
   "abilities": [
    {
     "name": "Heart's Thunder",
     "text": "After your Heat Refresh, you may place a Generic token on your Knight Board. When your [Heat] becomes equal to the number of Generic tokens you have (minimum 1), Shapeshift and reset your [Heat], then discard all Generic tokens.",
     "ops": [
      {
       "op": "heartsThunder"
      }
     ]
    },
    {
     "name": "Part of the Tribe",
     "text": "When another Knight is about to attack, if they are not on the same side of the Monster as you, you may place X Generic tokens on your Knight Board to move up to X spaces (maximum of 3).",
     "ops": [
      {
       "op": "partOfTribe",
       "max": 3
      }
     ],
     "note": "'Same side of the Monster' = the same quadrant (front/back/left/right by the larger axis) around the Monster."
    }
   ]
  },
  {
   "id": "simian-strategist",
   "name": "Simian Strategist",
   "tier": "vassal",
   "abilities": [
    {
     "name": "Beast Mode",
     "text": "At the start of your turn, you may gain +1 [Heat] to Shapeshift. When you Shapeshift, you may move 1 space. If you are adjacent to another Knight, you may swap places instead.",
     "ops": [
      {
       "op": "beastMode",
       "cost": 1
      },
      {
       "op": "shiftMove",
       "n": 1,
       "swap": true
      }
     ]
    },
    {
     "name": "You're in Here With Me",
     "text": "[HUMAN] After a Monster leaves the effective range of your Melee/Reach Weapon outside of your turn, you may move up to 2 spaces toward it. [APE] 1 [Heat] Reduce involuntary movement by 2.",
     "ops": [
      {
       "op": "chaseMonster",
       "n": 2,
       "form": "human"
      },
      {
       "op": "reduceInvol",
       "n": 2,
       "heat": 1,
       "form": "ape"
      }
     ]
    }
   ]
  },
  {
   "id": "rising-ape",
   "name": "Rising Ape",
   "tier": "devil",
   "abilities": [
    {
     "name": "Master of the Battlefield",
     "text": "After your [Heat] becomes exactly 3, 5, or 8, immediately Shapeshift. Then, you may resolve the corresponding effect: [Heat] 3: Move 1 space. [Heat] 5: You and/or another Knight moves 1 space. [Heat] 8: You and/or another Knight moves up to 2 spaces.",
     "ops": [
      {
       "op": "heatShift",
       "at": {
        "3": {
         "self": 1
        },
        "5": {
         "self": 1,
         "other": 1
        },
        "8": {
         "self": 2,
         "other": 2
        }
       }
      }
     ]
    },
    {
     "name": "Knights Together Strong",
     "text": "When you are about to attack, if you are on the VP, or if the last Knight who dealt a Wound (other than you) is not on the same side of the Monster as you, you may gain +2 [Precision] and Auto-hope 1.",
     "ops": [
      {
       "op": "knightsTogether"
      }
     ],
     "note": "'Same side of the Monster' = the same quadrant (front/back/left/right by the larger axis) around the Monster.",
     "unclear": []
    }
   ]
  },
  {
   "id": "beast-tamer",
   "name": "Beast Tamer",
   "tier": "devil",
   "abilities": [
    {
     "name": "Constantly Evolving",
     "text": "When you are about to use a Technique that has a Gated Effect of the shape you are not in, you may immediately Shapeshift. After a Monster leaves the effective range of your Melee/Reach Weapon outside of your turn, you may move up to 2 spaces toward it.",
     "ops": [
      {
       "op": "constantlyEvolving"
      },
      {
       "op": "chaseMonster",
       "n": 2
      }
     ]
    },
    {
     "name": "Best of Both Worlds",
     "text": "[HUMAN] When you attack a Monster while not adjacent, gain Diversion. [APE] When you attack a Monster while adjacent, gain BP Suppress.",
     "ops": [
      {
       "op": "bestOfBoth"
      }
     ]
    },
    {
     "name": "Primate Strength",
     "text": "You may equip one [two-hand] Weapon to a [one-hand] slot, but it has Commit while you are in Human form.",
     "ops": [
      {
       "op": "primateStrength"
      }
     ]
    }
   ]
  }
