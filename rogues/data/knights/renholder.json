   "tier": "starting",
   "magicLimit": 2,
   "abilities": [
    {
     "name": "Critical Light",
     "text": "If you roll a Crit Chance during an Attack or Evasion Roll, place 1 Magic [Magic] token in the Knight Pool. Magic Limit 2: There can't be more than 2 Magic [Magic] tokens in the Knight Pool at the same time. If multiple elements modify the Magic Limit, choose the highest Magic Limit.",
     "ops": [
      {
       "op": "criticalLight"
      }
     ]
