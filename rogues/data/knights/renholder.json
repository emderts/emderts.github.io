     "ops": [
      {
       "op": "upMySleeve"
      }
     ]
    }
   ]
  },
  {
   "id": "luxite",
   "name": "Luxite",
   "tier": "vassal",
   "magicLimit": 3,
   "abilities": [
    {
     "name": "Power from Camaraderie",
     "text": "Once per Knight Round and once per Monster Round, when another Knight uses a Technique or when a Squire uses an ability, you may place 1 Magic [Magic] token in the Knight Pool. Magic Limit 3: There can't be more than 3 Magic [Magic] tokens in the Knight Pool at the same time. If multiple elements modify the Magic Limit, choose the highest Magic Limit.",
     "ops": [
      {
       "op": "powerFromCamaraderie"
      }
     ]
    },
    {
     "name": "Aura of Illumination",
     "text": "Spend 1 Magic [Magic] token to place a Magic [Magic] token on your Knight Board. As long as there is at least 1 Magic [Magic] token on your Knight Board, you, and each Knight in Zone 1 from you, have Auto-fire 1 and \"Crit Chance: Gain +1 [Power].\" Discard the token at the end of your next turn.",
     "ops": [
      {
       "op": "auraOfIllumination"
      }
     ]
    }
   ]
  },
  {
   "id": "tenebrist",
   "name": "Tenebrist",
   "tier": "vassal",
   "magicLimit": 2,
   "abilities": [
    {
     "name": "Power from Pain",
     "text": "Whenever a Knight loses [Vigor], place 1 Magic [Magic] token in the Knight Pool. Magic Limit 2: There can't be more than 2 Magic [Magic] tokens in the Knight Pool at the same time. If multiple elements modify the Magic Limit, choose the highest Magic Limit.",
     "ops": [
      {
       "op": "powerFromPain"
      }
     ]
    },
    {
     "name": "Cloak of Shadows",
     "text": "Spend 1 Magic [Magic] token to place a Magic [Magic] token on the Clash Board adjacent to you (up to 2 tokens on the Board). Each Knight on that token, or in Zone 1 from at least 1 of those tokens, gains Guard 2 and \"Crit Evade: Gain a temporary positive Evasion [Evasion] token.\"",
     "ops": [
      {
       "op": "cloakOfShadows"
      }
     ]
    }
   ]
  },
  {
   "id": "harmonized-soul",
   "name": "Harmonized Soul",
   "tier": "devil",
   "magicLimit": 4,
   "abilities": [
    {
     "name": "Sympathetic Magic",
     "text": "When another Knight is hit by an Attack or fails to deal a Wound, place 1 Magic [Magic] token on their Knight Board. At the start of your turn, you may move those tokens either to your Knight Board or into the Knight Pool. Magic Limit 4: There can't be more than 4 Magic [Magic] tokens in the Knight Pool at the same time. If multiple elements modify the Magic Limit, choose the highest Magic Limit.",
     "ops": [
      {
       "op": "sympatheticMagic"
      }
     ]
    },
    {
     "name": "Manifestation",
     "text": "Knights with Magic [Magic] tokens on their Knight Boards may discard all their [Magic] tokens to gain Auto-black X or Soak X until the end of that Round. X is equal to the number of Magic [Magic] tokens discarded this way. They may use this ability as a free action or a [Reaction].",
     "ops": [
      {
       "op": "manifestation"
      }
     ]
    }
   ]
  },
  {
   "id": "luxfire-magus",
   "name": "Luxfire Magus",
   "tier": "devil",
   "magicLimit": 5,
   "abilities": [
    {
     "name": "Ebb and Flow of the Arcane",
     "text": "Whenever your [Heat] reaches Heat Limit [Heat Limit] or becomes 0, place 1 Magic [Magic] token in the Knight Pool. [JUDICIUM] 2 Magic [Magic] tokens instead. Magic Limit 5: There can't be more than 5 Magic [Magic] tokens in the Knight Pool at the same time. If multiple elements modify the Magic Limit, choose the highest Magic Limit.",
     "ops": [
      {
       "op": "ebbAndFlow"
      }
     ]
    },
    {
     "name": "Unholy Furnace",
     "text": "Once per turn, you may spend 1 Magic [Magic] token to perform Heat Refresh. When you are about to perform Heat Refresh, you may perform Card Refresh instead and vice versa.",
     "ops": [
      {
       "op": "unholyFurnace"
      }
     ]
    }
   ]
  }
