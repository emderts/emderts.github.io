{
 "id": "renholder",
 "name": "Renholder",
 "_source": "Knightbook 'The Tale of Renholder and the Secrets of the Spirit' (p.3–4 rules & Knight Setup, p.122 First Death Special Event) + Portrait / Talent / Heroic Arc / Technique sprite sheets (owner-supplied 2026-11-16).",
 "resourceToken": {
  "id": "magic",
  "name": "Magic",
  "keyword": "Magic X: During the second ability window, place X Magic tokens in the Knight Pool.",
  "rule": "Renholder uses special Magic tokens as a resource to power his spells and abilities. Magic tokens are mainly placed in the Knight Pool, and they can be spent from there. Each Renholder's Talent has a Magic Limit, which denotes how many Magic tokens can be in the Knight Pool at the same time. Magic Limit X: There can't be more than X Magic tokens in the Knight Pool. If multiple elements modify the Magic Limit, choose the highest Magic Limit. Magic tokens placed in other places than the Knight Pool cannot be spent to pay for Magic costs and do not count toward the Magic Limit."
 },
 "setup": {
  "virtues": {
   "Insight": 1,
   "Fortitude": 1,
   "Sagacity": 2
  },
  "rapportBoon": {
   "text": "Start of Clash: Cantrip 1.",
   "ops": [
    {
     "op": "poolToken",
     "token": "cantrip",
     "n": 1
    }
   ],
   "note": "[해석, 확인 필요] Rogue's Path에서 Rapport boon을 적용할지 — 현재 미적용 (Fleischritter와 동일하게 처리)."
  },
  "explorationCipher": "**13",
  "portraits": [
   "Mage Knight"
  ],
  "portrait": "mage-knight",
  "talent": "Mage Knight",
  "heroicArc": "Mage Knight",
  "perilArc": "Mage Knight",
  "techniques": [
   "Second Chance",
   "Knight Roll",
   "Knight Pose",
   "Lux Step",
   "Conjurer of Cheap Tricks"
  ],
  "techniquesNote": "Knightbook lists 'Clash side // Delve side' pairs (Knight Pose // Knight Prowess, Knight Roll // Prismatic Focus, Second Chance // Purifying Ritual, Lux Step // Light Our Way, Conjurer of Cheap Tricks // Divine the Heavens). Delve sides are not used in Rogue's Path.",
  "gear": [
   "Knighves",
   "Crude Bow"
  ],
  "gearNote": "Knightbook: '1 set of Knighves and the Crude Bow (Merchant gear)'. Crude Bow = Principality Merchant gear (data/gear/merchant_principality.json); two-handed, so the Knighves stay in reserve while it is equipped (소유자 확인 2026-11-16: 시작 장비의 Merchant 표기는 상점 Gear)."
 },
 "firstDeath": {
  "text": "Renholder's First Death Special Event (Knightbook p.122): if the Unknown Saint is not yet unlocked, see 9999 first; otherwise the event proceeds. Mark the First Death box on your Knight Sheet. Gain +1 Sigh of the Graal.",
  "ops": [
   {
    "op": "markFirstDeath"
   },
   {
    "op": "gainSigh",
    "n": 1
   }
  ],
