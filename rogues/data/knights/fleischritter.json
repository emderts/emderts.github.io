{
 "id": "fleischritter",
 "name": "Fleischritter",
 "_source": "Knightbook 'The Fleischritter and the Famishing' (p.3–4 rules & Knight Setup, p.111 First Death Special Event) + Talent card sprite sheets.",
 "resourceToken": {
  "id": "fleisch",
  "name": "Fleisch",
  "keyword": "Fleisch X: Place X Fleisch tokens in the Knight Pool.",
  "rule": "Fleisch tokens are mainly placed in the Knight Pool or your Knight Board, and they can be spent from there. Many Fleischritter Techniques use Fleisch as their cost. The most common source of Fleisch tokens is Fleischritter's Heroic Arc and the Fleisch X keyword. Fleischritter Talents also allow him to use Fleisch instead of Heat."
 },
 "setup": {
  "virtues": {
   "Bravery": 1,
   "Might": 1,
   "Fortitude": 2
  },
  "rapportBoon": {
   "text": "During Encounters: +1 [Precision]",
   "note": "Encounter(Delve) 전용 — Clash에는 적용되지 않음(확정). Rogue's Path에서 효과 없음."
  },
  "explorationCipher": "**23",
  "portraits": [
   "Fleischknecht"
  ],
  "talent": "Fleischknecht",
  "heroicArc": "Fleischknecht",
  "perilArc": "Fleischknecht",
  "techniques": [
   "Second Chance",
   "Knight Roll",
   "Knight Pose",
   "Cured Darklin",
   "Food Runner"
  ],
  "techniquesNote": "Knightbook lists 'Clash side // Delve side' pairs; the 5 Start cards (Second Chance, Knight Roll, Knight Pose, Cured Darklin, Food Runner) are the starting hand. Delve sides are not used in Rogue's Path.",
  "gear": [
   "Knighves",
   "Chipped Axe"
  ],
  "gearNote": "Chipped Axe = Merchant Gear",
  "portrait": "fleischknecht"
 },
 "firstDeath": {
  "text": "Fleischritter has perished this time, but something beyond the edge of this world is not done with him yet! Through the distorted nature of the Deep Fog, he will wander the Kingdoms Forlorn once more! Mark the First Death box on your Knight Sheet. Gain +1 Sigh of the Graal.",
  "ops": [
   {
    "op": "markFirstDeath"
   },
   {
    "op": "gainSigh",
    "n": 1
   }
  ],
  "note": "If the Unknown Saint is not yet unlocked, resolve Kingdom Mysteries 9999 first (data/rules/unknown_saint.json) — this happens once per campaign, for whichever Knight dies first. Then (or otherwise) resolve this Knight's own First Death Event."
 },
