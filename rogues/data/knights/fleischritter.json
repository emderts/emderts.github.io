 "talents": [
  {
   "id": "fleischknecht",
   "name": "Fleischknecht",
   "tier": "starting",
   "abilities": [
    {
     "name": "Refreshing Fleisch",
     "text": "You may use Fleisch tokens from the Knight Pool instead of [Heat].",
     "ops": [
      {
       "op": "fleischAsHeat"
      }
     ]
    },
    {
     "name": "Meat Provisions",
     "text": "When you attack, if there are no Opening or Break tokens in the Knight Pool, immediately place 1 Opening and 1 Break token in the Knight Pool.",
     "ops": [
      {
       "op": "onAttackDeclare",
       "if": {
        "poolLacks": [
         "opening",
         "break"
        ]
       },
       "do": [
        {
         "op": "pool",
         "token": "opening",
         "n": 1
        },
        {
         "op": "pool",
         "token": "break",
         "n": 1
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "fleischjager",
   "name": "Fleischjäger",
   "tier": "vassal",
   "abilities": [
    {
     "name": "Nurturing Fleisch",
     "text": "1 Fleisch, X [Vigor]: An adjacent Knight gains +X [Vigor]. You may use Fleisch tokens from the Knight Pool instead of [Heat].",
     "ops": [
      {
       "op": "active",
       "cost": {
        "fleisch": 1,
        "vigor": "X"
       },
       "timing": "free",
       "do": [
        {
         "op": "gainVigor",
         "target": "adjacentKnight",
         "n": "X"
        }
       ]
      },
      {
       "op": "fleischAsHeat"
      }
     ]
    },
    {
     "name": "Rebound",
     "text": "During an Armor Roll, add all following tokens to the Knight Pool, depending on the number of mitigated [Vigor] loss: 1: Opening 1 · 2: Break 1 · 3: Fleisch 1 · 4: Rouse 1 · 5: Power 1",
     "ops": [
      {
       "op": "onArmorRoll",
       "byMitigated": {
        "1": [
         {
          "op": "pool",
          "token": "opening",
          "n": 1
         }
        ],
        "2": [
         {
          "op": "pool",
          "token": "break",
          "n": 1
         }
        ],
        "3": [
         {
          "op": "pool",
          "token": "fleisch",
          "n": 1
         }
        ],
        "4": [
         {
          "op": "pool",
          "token": "rouse",
          "n": 1
         }
        ],
        "5": [
         {
          "op": "pool",
          "token": "power",
          "n": 1
         }
        ]
       },
       "cumulative": true
      }
     ]
    }
   ]
  },
  {
   "id": "fleischkrieger",
   "name": "Fleischkrieger",
   "tier": "vassal",
   "abilities": [
    {
     "name": "Bolstering Fleisch",
     "text": "1 Fleisch, X [Heat]: When you are about to attack, add X Knight tokens to the Knight Pool, each from a different Level of your Heroic Arc, up to your [Passion] Level. You cannot benefit from those keywords again during the second ability window. You may use Fleisch tokens from the Knight Pool instead of [Heat].",
     "ops": [
      {
       "op": "active",
       "cost": {
        "fleisch": 1,
        "heat": "X"
       },
       "timing": "beforeAttack",
       "do": [
        {
         "op": "bolsteringFleisch"
        }
       ]
      },
      {
       "op": "fleischAsHeat"
      }
     ]
    },
    {
     "name": "Ambidextrous",
     "text": "When you attack and have a Weapon with the Pair Trait or an inactive [1H] Weapon, gain +1 [Attack die]. For the purpose of gathering your Power Pool, ignore any hits that exceed your Weapon's regular [Attack dice] number. During the second ability window, you may place up to 2 additional tokens from any stackable keyword on your inactive [1H] Weapon or a Weapon with the Pair Trait.",
     "ops": [
      {
       "op": "ambidextrous"
      }
     ]
    }
   ]
  },
  {
   "id": "teufelsjager",
   "name": "Teufelsjäger",
   "tier": "devil",
   "abilities": [
    {
     "name": "Empowering Fleisch",
     "text": "When you attack, you may spend X Fleisch to add +X [Attack dice] to your Attack Roll. If the number of hits exceeds your Weapon's [Attack dice] number, ignore those additional hits when creating the Power Pool, but immediately place a Sunder token in the Knight Pool. You may use Fleisch tokens from the Knight Pool instead of [Heat].",
     "ops": [
      {
       "op": "empoweringFleisch"
      },
      {
       "op": "fleischAsHeat"
      }
     ]
    },
    {
     "name": "The Art of Gastronomy",
     "text": "Whenever you spend Fleisch on Techniques, place a Generic token on your Knight Board. You may discard an indicated number of those tokens to trigger the following effects (as a free action, unless stated otherwise): 1: When you attack, gain +2 Precision. 2: When you attack, gain Auto-hope 2. 3: Advanced Block. 5: Discard all Condition tokens and cards. 7: Ignore [Vigor] loss from a Monster Attack.",
     "ops": [
      {
       "op": "artOfGastronomy"
      }
     ]
    }
   ]
  },
  {
   "id": "schwarzesser",
   "name": "Schwarzesser",
   "tier": "devil",
   "abilities": [
    {
     "name": "Famished Fleisch",
     "text": "Wound: If you're adjacent to another Knight, you may spend X Fleisch tokens to place X Generic tokens on your Knight Board. As long as there is at least 1 Generic token on your Knight Board, treat your Knight Power die as one tier higher, gain Immune to Mind Condition cards and Braced. At the start and the end of Knight Round, all adjacent Knights lose -5 [Vigor]. Discard 1 Generic token at the end of your turn, and whenever you fail to deal a Wound. You may use Fleisch tokens from the Knight Pool instead of [Heat].",
     "ops": [
      {
       "op": "famishedFleisch"
      },
      {
       "op": "fleischAsHeat"
      }
     ]
    },
    {
     "name": "Monstrous Strength",
     "text": "You can either use [2H] Weapons as if they were [1H], or when using a [1H] Weapon, you may add +[red Power die] to the Power Pool.",
     "ops": [
      {
       "op": "monstrousStrength"
      }
     ]
    }
   ]
  }
