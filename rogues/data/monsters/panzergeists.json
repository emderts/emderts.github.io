 "traits": [
  {
   "name": "Suit Up!",
   "level": 1,
   "text": "Additional Setup: Place 10 Armor [Armor] tokens on the Clash Board as indicated in Clash Setup. Whenever a Panzergeist moves onto or through a space with an Armor [Armor] token on it, place it on that Mob’s BP. When you deal a Wound to a Panzergeist with Armor [Armor] tokens, place all those tokens on the space it occupied.",
   "implemented": true
  },
  {
   "name": "Ceaseless Hunger",
   "level": 1,
   "text": "When your Maximum [V] becomes 0 or lower, do not draw a Judicium. Instead, immediately place the closest Mob on your Knight Board and end your turn—you are Possessed. As long as you’re Possessed, treat your miniature as that Mob’s miniature. You cannot attack, use abilities, or move voluntarily, and you skip your turns. When you die, place the Mob that Possessed you on the space you occupied. When that Mob is wounded, remove it from your Knight Board and reset your Maximum [V]—you’re no longer Possessed. If all Knights are Possessed at any point, you immediately lose the Clash.\n\nRecover X: Raise your Maximum [V] by X until the end of the Clash, then gain +X [V].\n\nEnd of Clash: If you’re still Possessed, die and permanently lower your Maximum [V] by 1 (note this on your Knight Sheet).",
   "implemented": true
  },
  {
   "name": "All Things Die",
   "level": 1,
   "text": "! Panzergeists without any Armor [Armor] tokens gain +4 [To Hit] when attacked with a Weapon [Gear] card without the Rust, Ethereal, or Holy Trait.\nRust: Place a Bane [Bane] token on each Gear [Gear] card with the Metal Trait equipped on your Knight. Gear [Gear] cards with Bane [Bane] tokens on them gain the Rust Trait and lose the Metal Trait. Those Bane [Bane] tokens still count toward your Bane Limit.",
   "implemented": true
  },
  {
   "name": "Panzer Cascade",
   "level": 2,
   "text": "! Panzergeist Attacks gain +1 [die] for each Armor [Armor] token on the attacking Mob.\n\nDuring Escalation, if there are no more AI cards in the Escalation decks, instead place an Armor [Armor] token on the Mob with the lowest BP Level.",
   "implemented": true
  },
  {
   "name": "Muffled Potential",
   "level": 2,
   "text": "Ignore 1 [Potential] on each Power die you roll when attacking with a Weapon [Gear] card with the Rust Trait.",
   "implemented": true
  },
  {
   "name": "Soul of the Metal",
   "level": 3,
   "text": "End of each Activation: Move this Mob onto the closest Armor [Armor] token.",
   "implemented": true
  },
  {
   "name": "Armored Contagion",
   "level": 3,
   "text": "All Gear [Gear] cards without the Ethereal, Holy, or Rust Trait gain the Metal Trait.",
   "implemented": true
  },
  {
   "name": "No Rest for Any",
   "level": 4,
   "text": "End of Knight Round: The Knight with the [Priority Target] Priority Target token lowers their Maximum [V] by 6.\n\nStart of your turn: If Possessed, the Mob on your Knight Board performs Signature (you still skip your turn).",
   "implemented": true
  }
 ],
