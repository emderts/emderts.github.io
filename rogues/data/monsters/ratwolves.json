 "traits": [
  {
   "name": "Strength of the Pack",
   "level": 1,
   "text": "A Ratwolf’s Toughness value, shown directly above the AT value, indicates how many times it can survive a Knight Attack that would otherwise be deadly. When you are about to wound a BP card, if the number of Generic tokens on it is equal to its Toughness value, you simply deal a Wound and the Ratwolf dies. Otherwise, instead of dealing a Wound, place a Generic token on this BP card and leave it revealed on the Mob track, then resolve Responses as if you dealt a Wound.\n\nWhen a Ratwolf dies, finish resolving the current action, then Spawn a new Ratwolf with a BP of one Level higher. If there are no valid BP cards, Spawn a Ratwolf of the same BP Level or lower (prioritizing higher Levels). New Ratwolves Spawn adjacent to a random Knight, on a space closest to the Board Edge and without an Obstacle. If that space is occupied by another miniature, Displace it. Then, the spawned Ratwolf performs Signature.",
   "implemented": true
  },
  {
   "name": "Rising Pressure",
   "level": 1,
   "text": "When a Knight gains Condition tokens, they gain that much [H].",
   "implemented": true
  },
  {
   "name": "Go for the Weakest Link",
   "level": 1,
   "text": "After resolving all other Attack Consequences:\n• If you are knocked down, Afflict 1.\n• If you are a Lone Knight, Afflict 1.",
   "implemented": true
  },
  {
   "name": "Relentless Pull",
   "level": 2,
   "text": "Increase each Drag performed by Ratwolves by 1 for every Condition token on the Target.",
   "implemented": true
  },
  {
   "name": "Into the Chittering Shadows",
   "level": 2,
   "text": "Ratwolves always perform Drag toward the closest short Board Edge.",
   "implemented": true
  },
  {
   "name": "Kinderfänger",
   "level": 3,
   "text": "At the end of a Drag performed by a Ratwolf, if you are a Lone Knight, suffer Knockdown.",
   "implemented": true
  },
  {
   "name": "Adaptability",
   "level": 3,
   "text": "This Trait changes depending on the Kingdom. Refer to the Kingdom Trait.",
   "implemented": true
  },
  {
   "name": "Ravening Ratswarm",
   "level": 4,
   "text": "During a Drag performed by a Ratwolf, if it would cause that Ratwolf to move past a short Board Edge, the Target dies. Place the Ratwolf adjacent to a random Knight on a space closest to a short Board Edge and without an Obstacle. If that space is occupied by another miniature, Displace it.",
   "implemented": true
  },
  {
   "name": "Rat King",
   "level": 4,
   "text": "Knights cannot discard Condition cards with Condition tokens, or discard any tokens from those cards, unless adjacent to another Knight.",
   "implemented": true
  },
  {
   "name": "Parasite Bed",
   "level": 1,
   "text": "[Kingdom Trait — Principality of Stone] Afflict X: Parasitize X.\n\nAdaptability (Level 3+): After you perform a [Peril], suffer a penalty based on the number of Condition tokens you have:\n2–3: Cooldown.\n4+: Delay.",
   "implemented": true
  },
  {
   "name": "Bile and Poison",
   "level": 1,
   "text": "[Kingdom Trait — Sunken Kingdom] Afflict X: Poison X.\n\nAdaptability (Level 3+): During an Armor Roll, ignore X rolled [Armor symbol], where X is the number of your Condition tokens.",
   "implemented": true
  }
 ],
